@model IEnumerable<SmartApiGateway.Models.AuditLog>
@{
    ViewData["Title"] = "აუდიტის ჟურნალი";
}

<div class="max-w-6xl mx-auto">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center">
            <i data-lucide="clipboard-list" class="w-6 h-6 mr-3 text-blue-500"></i> აუდიტის ჟურნალი (Audit Logs)
        </h1>
        <p class="text-slate-500 mt-1">სისტემაში განხორციელებული ყველა ადმინისტრაციული ქმედების მონიტორინგი</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600 uppercase tracking-wider">
                        <th class="px-6 py-4">მომხმარებელი</th>
                        <th class="px-6 py-4">კონტროლერი / აქცია</th>
                        <th class="px-6 py-4">აღწერა</th>
                        <th class="px-6 py-4">IP მისამართი</th>
                        <th class="px-6 py-4">თარიღი</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-10 text-center text-slate-400">
                                <i data-lucide="info" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                                ჩანაწერები ვერ მოიძებნა
                            </td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-900">
                                <div class="flex items-center space-x-2">
                                    <div class="w-7 h-7 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 text-xs font-bold uppercase">
                                        @(string.IsNullOrEmpty(log.UserName) ? "?" : log.UserName.Substring(0, 1).ToUpper())
                                    </div>
                                    <span>@log.UserName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded-md">@log.Controller</span>
                                <span class="text-slate-400 mx-1">/</span>
                                <span class="text-slate-600">@log.Action</span>
                            </td>
                            <td class="px-6 py-4 text-slate-600">@log.Description</td>
                            <td class="px-6 py-4 font-mono text-xs text-slate-500">@log.IpAddress</td>
                            <td class="px-6 py-4 text-slate-500 text-xs">
                                @log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>