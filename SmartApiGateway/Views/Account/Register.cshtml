@model SmartApiGateway.ViewModels.RegisterViewModel
@using Microsoft.AspNetCore.Localization

@{
    Layout = null;
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}
<!DOCTYPE html>
<html lang="@(isEn ? "en" : "ka")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T("რეგისტრაცია", "Registration") - Synox Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Noto Sans Georgian', sans-serif;
        }</style>
    </head>
    <body class="bg-slate-50 flex items-center justify-center min-h-screen p-4 relative">

        <div class="absolute top-6 right-6 z-20">
            <div class="relative inline-block text-left" id="language-switcher">
                <form id="langForm" asp-controller="Home" asp-action="SetLanguage" method="post" class="m-0">
                    <input type="hidden" name="returnUrl" value="/Account/Register" />
                    <input type="hidden" name="culture" id="cultureInput" value="@(isEn ? "en" : "ka")" />

                    <button type="button" id="lang-menu-button" class="flex items-center space-x-2 bg-white hover:bg-slate-50 border border-slate-200 px-3 py-2 rounded-xl transition duration-200 shadow-sm">
                        <i data-lucide="globe" class="w-4 h-4 text-blue-500"></i>
                        <span class="text-sm font-bold text-slate-700">@(isEn ? "EN" : "KA")</span>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                    </button>

                    <div id="lang-menu" class="hidden absolute right-0 mt-2 w-40 rounded-2xl shadow-xl bg-white border border-slate-100 divide-y divide-slate-50 z-50">
                        <div class="p-1.5">
                            <button type="button" onclick="submitLang('ka')" class="w-full text-left flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl hover:bg-slate-50 transition-colors @(!isEn ? "bg-blue-50 text-blue-600" : "text-slate-600")">
                                <span class="text-base mr-3">🇬🇪</span> ქართული
                            </button>
                            <button type="button" onclick="submitLang('en')" class="w-full text-left flex items-center px-3 py-2.5 text-sm font-semibold rounded-xl hover:bg-slate-50 transition-colors @(isEn ? "bg-blue-50 text-blue-600" : "text-slate-600")">
                                <span class="text-base mr-3">🇬🇧</span> English
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="bg-white p-8 rounded-3xl shadow-xl max-w-lg w-full border border-slate-100 z-10">

            <div class="text-center mb-8">
                <div class="w-14 h-14 bg-green-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="user-plus" class="w-7 h-7 text-green-600"></i>
                </div>
                <h2 class="text-2xl font-black text-slate-800">@T("ახალი მომხმარებელი", "New User")</h2>
                <p class="text-slate-500 text-sm mt-2">@T("შეავსეთ ყველა ველი ანგარიშის შესაქმნელად", "Fill in all fields to create an account")</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm bg-red-50 p-3 rounded-xl border border-red-100"></div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">@T("სახელი", "First Name")</label>
                        <input asp-for="FirstName" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" />
                        <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">@T("გვარი", "Last Name")</label>
                        <input asp-for="LastName" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" />
                        <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("ელ-ფოსტა", "Email")</label>
                    <input asp-for="Email" type="email" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" placeholder="user@example.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("პაროლი", "Password")</label>
                    <input asp-for="Password" type="password" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" placeholder="@T("მინიმუმ 8 სიმბოლო", "Minimum 8 characters")" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                    <p class="text-xs text-slate-400 mt-1">@T("მინიმუმ 8 სიმბოლო, ერთი დიდი ასო და ერთი ციფრი.", "Minimum 8 chars, 1 uppercase, 1 number.")</p>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("გაიმეორეთ პაროლი", "Confirm Password")</label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-green-500/30 transition">
                    @T("ანგარიშის შექმნა", "Create Account")
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                @T("უკვე გაქვთ ანგარიში?", "Already have an account?")
                <a href="/Account/Login" class="text-blue-600 hover:text-blue-700 font-bold transition">@T("შესვლა", "Log in")</a>
            </p>
        </div>

        <script>
            lucide.createIcons();
            const langBtn = document.getElementById('lang-menu-button');
            const langMenu = document.getElementById('lang-menu');
            if(langBtn && langMenu) {
            langBtn.addEventListener('click', (e) => { e.stopPropagation(); langMenu.classList.toggle('hidden'); });
            document.addEventListener('click', (e) => { if (!langMenu.contains(e.target) && !langBtn.contains(e.target)) langMenu.classList.add('hidden'); });
            }
            function submitLang(culture) { document.getElementById('cultureInput').value = culture; document.getElementById('langForm').submit(); }
        </script>
    </body></html>