@model SmartApiGateway.ViewModels.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>რეგისტრაცია - Smart API Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex items-center justify-center h-screen">

    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-lg border border-slate-200">
        <h2 class="text-2xl font-bold text-center text-slate-800 mb-6">რეგისტრაცია</h2>
        
        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4 text-center"></div>
            
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">სახელი</label>
                    <input asp-for="FirstName" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:border-blue-500">
                        <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
                    </div>
                    <div>
                        <label class="block text-slate-700 text-sm font-bold mb-2">გვარი</label>
                        <input asp-for="LastName" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:border-blue-500">
                            <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-slate-700 text-sm font-bold mb-2">ელ-ფოსტა</label>
                        <input asp-for="Email" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:border-blue-500">
                            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                        </div>
            
                        <div class="mb-4">
                            <label class="block text-slate-700 text-sm font-bold mb-2">პაროლი</label>
                            <input asp-for="Password" type="password" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:border-blue-500">
                                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                            </div>

                            <div class="mb-6">
                                <label class="block text-slate-700 text-sm font-bold mb-2">გაიმეორეთ პაროლი</label>
                                <input asp-for="ConfirmPassword" type="password" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:border-blue-500">
                                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
                                </div>
            
                                <button type="submit" class="w-full bg-green-600 text-white font-bold py-2 px-4 rounded hover:bg-green-700 transition">
                                    რეგისტრაცია
                                </button>
                            </form>
        
                            <p class="mt-4 text-center text-sm text-slate-600">
                                უკვე გაქვთ ანგარიში? <a href="/Account/Login" class="text-blue-600 hover:underline">შესვლა</a>
                            </p>
                        </div>

                    </body>
                </html>