@model SmartApiGateway.ViewModels.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>რეგისტრაცია - Smart API Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Noto Sans Georgian', sans-serif;
        }</style>
    </head>
    <body class="bg-slate-50 flex items-center justify-center min-h-screen p-4">

        <div class="bg-white p-8 rounded-3xl shadow-xl max-w-lg w-full border border-slate-100">

            <div class="text-center mb-8">
                <div class="w-14 h-14 bg-green-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-black text-slate-800">ახალი მომხმარებელი</h2>
                <p class="text-slate-500 text-sm mt-2">შეავსეთ ყველა ველი ანგარიშის შესაქმნელად</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-red-600 text-sm bg-red-50 p-3 rounded-xl border border-red-100"></div>

                @* სახელი / გვარი *@
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">სახელი</label>
                        <input asp-for="FirstName"
                               class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl
                        focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" />
                        <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">გვარი</label>
                        <input asp-for="LastName"
                               class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl
                        focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm" />
                        <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                @* ელ-ფოსტა *@
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">ელ-ფოსტა</label>
                    <input asp-for="Email" type="email"
                           class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm"
                           placeholder="user@example.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                @* პაროლი *@
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">პაროლი</label>
                    <input asp-for="Password" type="password"
                           class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm"
                           placeholder="მინიმუმ 8 სიმბოლო" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                    <p class="text-xs text-slate-400 mt-1">
                        მინიმუმ 8 სიმბოლო, ერთი დიდი ასო და ერთი ციფრი.
                    </p>
                </div>

                @* პაროლის გამეორება *@
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">გაიმეორეთ პაროლი</label>
                    <input asp-for="ConfirmPassword" type="password"
                           class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm"
                           placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3.5
                    rounded-xl shadow-lg shadow-green-500/30 transition">
                    ანგარიშის შექმნა
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                უკვე გაქვთ ანგარიში?
                <a href="/Account/Login" class="text-blue-600 hover:text-blue-700 font-bold transition">
                    შესვლა
                </a>
            </p>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }

    </body>
</html>
