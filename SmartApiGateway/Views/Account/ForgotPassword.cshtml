@{
    ViewData["Title"] = "პაროლის აღდგენა";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>პაროლის აღდგენა - Smart Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Noto Sans Georgian', sans-serif;
        }</style>
    </head>
    <body class="bg-slate-50 flex items-center justify-center min-h-screen p-4">

        <div class="bg-white p-8 rounded-3xl shadow-xl max-w-md w-full border border-slate-100">
            <div class="text-center mb-8">
                <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-black text-slate-800">პაროლის აღდგენა</h2>
                <p class="text-slate-500 text-sm mt-2">შეიყვანეთ ელ-ფოსტა გამაგზავნელი ბმულის მისაღებად.</p>
            </div>

            @* შეცდომა *@
            @if (TempData["Error"] != null)
            {
                <div class="mb-5 p-4 bg-red-50 border border-red-100 rounded-xl text-sm text-red-700">
                    @TempData["Error"]
                </div>
            }

            @* ფორმა — მხოლოდ მაშინ ვაჩვენოთ, თუ ბმული ჯერ არ გაგზავნილა *@
            @if (TempData["Message"] == null)
            {
                <form asp-action="ForgotPassword" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">ელ-ფოსტა</label>
                        <input type="email" name="email" required
                               placeholder="თქვენი ელ-ფოსტა"
                               class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl
                        focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                    </div>
                    <button type="submit"
                            class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold
                        rounded-xl shadow-lg shadow-blue-500/30 transition">
                        აღდგენის გაგზავნა
                    </button>
                </form>
            }
            else
            {
                @* წარმატების მდგომარეობა *@
                <div class="p-4 bg-green-50 border border-green-100 rounded-xl text-sm text-green-700 mb-5">
                    @TempData["Message"]
                </div>

                @* DEV გარემო — reset ბმული ეკრანზე (production-ში email-ით გაიგზავნება) *@
                @if (TempData["DevResetLink"] != null)
                {
                    <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl mb-5">
                        <p class="text-xs font-bold text-amber-700 uppercase tracking-wide mb-2">
                            🛠 Dev/Test გარემო — ბმული
                        </p>
                        <p class="text-xs text-amber-600 mb-3">
                            Production-ში ეს ბმული ელ-ფოსტით იგზავნება.
                        </p>
                        <a href="@TempData["DevResetLink"]"
                               class="block text-xs text-blue-600 underline break-all font-mono">
                            @TempData["DevResetLink"]
                        </a>
                    </div>
                }
            }

            <div class="mt-6 text-center">
                <a href="/Account/Login"
                       class="text-sm text-slate-500 hover:text-blue-600 font-bold transition">
                    ← უკან დაბრუნება
                </a>
            </div>
        </div>

    </body>
</html>
