@{
    ViewData["Title"] = "პაროლის აღდგენა"; Layout = null;
}
<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>პაროლის აღდგენა - Smart Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-3xl shadow-xl max-w-md w-full border border-slate-100">
        <h2 class="text-2xl font-black text-slate-800 mb-2">პაროლის აღდგენა</h2>
        <p class="text-slate-500 text-sm mb-6">შეიყვანეთ ელ-ფოსტა აღდგენის ბმულის მისაღებად.</p>

        @if (TempData["Error"] != null)
        {
            <div class="mb-4 text-sm text-red-600 bg-red-50 p-3 rounded-lg">@TempData["Error"]</div>
        }

        @if (TempData["ResetToken"] == null)
        {
            <form asp-action="ForgotPassword" method="post" class="space-y-4">
                <input type="email" name="email" required placeholder="თქვენი ელ-ფოსტა" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" />
                <button type="submit" class="w-full py-3 bg-blue-600 text-white font-bold rounded-xl shadow-lg">აღდგენა</button>
            </form>
        }
        else
        {
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 mb-6">
                <p class="text-xs text-blue-800 font-mono break-all mb-2">Token: @TempData["ResetToken"]</p>
                <p class="text-sm font-bold text-blue-700">@TempData["Message"]</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="space-y-4">
                <input type="hidden" name="email" value="@TempData["ResetEmail"]" />
                <input type="hidden" name="token" value="@TempData["ResetToken"]" />
                <input type="password" name="newPassword" required placeholder="შეიყვანეთ ახალი პაროლი" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-green-500 outline-none" />
                <button type="submit" class="w-full py-3 bg-green-500 text-white font-bold rounded-xl shadow-lg">პაროლის შენახვა</button>
            </form>
        }

        <div class="mt-6 text-center">
            <a href="/Account/Login" class="text-sm text-slate-500 hover:text-blue-600 font-bold">უკან დაბრუნება</a>
        </div>
    </div>
</body>
</html>