@model SmartApiGateway.ViewModels.ManageRolePermissionsViewModel
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "უფლებების მართვა";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}

<div class="max-w-4xl mx-auto bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
    <div class="mb-8 border-b border-slate-100 pb-6 flex items-center justify-between">
        <h2 class="text-2xl font-black text-slate-800 flex items-center">
            <!-- დავაბრუნეთ ღია, ფერადი აიქონი -->
            <span class="w-10 h-10 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mr-3 shadow-sm">
                <i data-lucide="shield-check" class="w-5 h-5"></i>
            </span>
            @T("როლის უფლებები:", "Role Permissions:") <span class="text-indigo-600 ml-2">@Model.RoleName</span>
        </h2>
    </div>

    <form asp-action="Manage" method="post">
        <input type="hidden" asp-for="RoleId" />
        <input type="hidden" asp-for="RoleName" />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
            @for (int i = 0; i < Model.RoleClaims.Count; i++)
            {
                <label class="relative flex items-center p-4 border border-slate-200 rounded-2xl cursor-pointer transition-all duration-200 hover:border-indigo-300 hover:shadow-sm has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/50 has-[:checked]:shadow-md group">
                    <input type="hidden" asp-for="@Model.RoleClaims[i].Type" />
                    <input type="hidden" asp-for="@Model.RoleClaims[i].Value" />
                    
                    <div class="flex items-center justify-center w-6 h-6 mr-3 border-2 border-slate-300 rounded bg-white transition-colors group-has-[:checked]:border-indigo-500 group-has-[:checked]:bg-indigo-500">
                        <i data-lucide="check" class="w-4 h-4 text-white opacity-0 group-has-[:checked]:opacity-100 transition-opacity"></i>
                    </div>
                    <input asp-for="@Model.RoleClaims[i].Selected" class="sr-only" />
                    <span class="font-bold text-sm text-slate-700 group-has-[:checked]:text-indigo-900 select-none">
                        @Model.RoleClaims[i].Value
                    </span>
                </label>
            }
        </div>

        <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4">
            <!-- შენახვა ღილაკიც დავაბრუნეთ Indigo ფერში -->
            <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-indigo-600 text-white rounded-xl font-bold shadow-lg shadow-indigo-600/30 hover:bg-indigo-700 transition flex items-center justify-center">
                <i data-lucide="save" class="w-4 h-4 mr-2"></i> @T("შენახვა", "Save Changes")
            </button>
            <a asp-controller="Roles" asp-action="Index" class="w-full sm:w-auto px-8 py-3 bg-slate-100 text-slate-600 rounded-xl font-bold text-center hover:bg-slate-200 transition">
                @T("გაუქმება", "Cancel")
            </a>
        </div>
    </form>
</div>