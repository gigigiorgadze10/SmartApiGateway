@model IEnumerable<SmartApiGateway.Models.BlockedIp>
@{
    ViewData["Title"] = "დაბლოკილი IP-ები";
}

<div class="container-fluid">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-slate-800">IP მისამართების ბლოკირება</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <h3 class="text-lg font-semibold mb-4 text-slate-700">ახალი IP-ს დაბლოკვა</h3>
                <form asp-action="Create" method="post" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-600 mb-1">IP მისამართი</label>
                        <input type="text" name="ipAddress" class="w-full p-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="მაგ: 192.168.1.1" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-600 mb-1">მიზეზი</label>
                        <textarea name="reason" class="w-full p-2.5 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" rows="3" placeholder="რატომ იბლოკება?"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-lg transition shadow-lg flex items-center justify-center">
                        <i data-lucide="ban" class="w-4 h-4 mr-2"></i> დაბლოკვა
                    </button>
                </form>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase text-xs font-bold">
                            <th class="p-4">IP მისამართი</th>
                            <th class="p-4">მიზეზი</th>
                            <th class="p-4 text-right">მოქმედება</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="p-8 text-center text-slate-400">დაბლოკილი IP-ები არ მოიძებნა</td>
                            </tr>
                        }
                        @foreach (var ip in Model)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-4">
                                    <span class="font-mono text-blue-600 bg-blue-50 px-2 py-1 rounded text-sm font-bold">@ip.IpAddress</span>
                                </td>
                                <td class="p-4 text-slate-600 text-sm">@ip.Reason</td>
                                <td class="p-4 text-right">
                                    <form asp-action="Delete" asp-route-id="@ip.Id" method="post" onsubmit="return confirm('ნამდვილად გსურთ ბლოკის მოხსნა?');" class="inline">
                                        <button type="submit" class="text-slate-400 hover:text-green-600 transition p-2 hover:bg-green-50 rounded-lg">
                                            <i data-lucide="unlock" class="w-5 h-5"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>