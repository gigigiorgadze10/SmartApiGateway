@model IEnumerable<SmartApiGateway.Models.BlockedIp>
@using System.Security.Claims
@{
    ViewData["Title"] = "დაბლოკილი IP-ები";
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">IP მისამართების ბლოკირება</h2>
            <p class="text-slate-500 text-sm mt-1">აკონტროლეთ არასასურველი წვდომა და იხილეთ ბლოკირების ისტორია</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 sticky top-6">
                <h3 class="text-lg font-bold mb-4 text-slate-700 flex items-center">
                    <i data-lucide="shield-alert" class="w-5 h-5 mr-2 text-red-500"></i> ახალი ბლოკი
                </h3>
                <form asp-action="Create" method="post" class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-1.5 ml-1">IP მისამართი</label>
                        <input type="text" name="ipAddress" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500 outline-none transition font-mono text-sm" placeholder="მაგ: 192.168.1.100" required />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-1.5 ml-1">ბლოკირების მიზეზი</label>
                        <textarea name="reason" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500 outline-none transition text-sm" rows="3" placeholder="მაგ: SPAM შეტევა, ბევრი მოთხოვნა..."></textarea>
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3.5 rounded-xl transition shadow-lg shadow-red-500/30 flex items-center justify-center">
                        <i data-lucide="ban" class="w-4 h-4 mr-2"></i> მისამართის დაბლოკვა
                    </button>
                </form>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="bg-white shadow-sm border border-slate-200 rounded-3xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase text-[11px] font-black tracking-wider">
                                <th class="p-4 pl-6">IP მისამართი / მიზეზი</th>
                                <th class="p-4 text-center">ტრაფიკის ისტორია</th>
                                <th class="p-4">ვინ დაბლოკა</th>
                                <th class="p-4 pr-6 text-right">მოქმედება</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!Model.Any())
                            {
                                <tr><td colspan="4" class="p-8 text-center text-slate-400">დაბლოკილი მისამართები არ მოიძებნა</td></tr>
                            }
                            
                            @{
                                var trafficDict = ViewBag.TrafficCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
                            }

                            @foreach (var ip in Model)
                            {
                                var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                                var isSuperAdmin = User.IsInRole("SuperAdmin");
                                var canUnlock = isSuperAdmin || ip.BlockedById == currentUserId;
                                var historyCount = trafficDict.ContainsKey(ip.IpAddress) ? trafficDict[ip.IpAddress] : 0;

                                <tr class="hover:bg-slate-50 transition">
                                    <td class="p-4 pl-6">
                                        <div class="font-mono text-sm text-red-600 font-bold">@ip.IpAddress</div>
                                        <div class="text-xs text-slate-500 mt-1 max-w-[200px] truncate" title="@ip.Reason">@(string.IsNullOrEmpty(ip.Reason) ? "მიზეზი მითითებული არ არის" : ip.Reason)</div>
                                    </td>
                                    <td class="p-4 text-center">
                                        @if (historyCount > 0)
                                        {
                                            <span class="inline-flex items-center px-2 py-1 rounded bg-orange-50 text-orange-600 text-xs font-bold border border-orange-100" title="სისტემაში დაფიქსირებული მოთხოვნები">
                                                <i data-lucide="activity" class="w-3 h-3 mr-1"></i> @historyCount შემოწმება
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">ისტორიის გარეშე</span>
                                        }
                                    </td>
                                    <td class="p-4">
                                        @if (ip.BlockedBy != null)
                                        {
                                            <div class="flex items-center" title="@ip.BlockedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")">
                                                <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px] font-bold mr-2 uppercase">
                                                    @(ip.BlockedBy?.UserName?.Substring(0, 1) ?? "U")
                                                </div>
                                                <span class="text-xs font-bold text-slate-700">@(ip.BlockedBy?.UserName ?? "Unknown")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-bold text-slate-400">სისტემა</span>
                                        }
                                    </td>
                                    <td class="p-4 pr-6 text-right">
                                        @if (canUnlock)
                                        {
                                            <form asp-action="Delete" asp-route-id="@ip.Id" method="post" onsubmit="return confirm('ნამდვილად გსურთ ბლოკის მოხსნა?');">
                                                <button type="submit" class="p-2 text-slate-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition shadow-sm border border-transparent hover:border-green-100" title="ბლოკის მოხსნა">
                                                    <i data-lucide="unlock" class="w-5 h-5"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-slate-400 bg-slate-50 px-2 py-1 rounded border border-slate-100 uppercase font-bold">მხოლოდ ნახვა</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}