@model IEnumerable<SmartApiGateway.Models.BlockedIp>
@using System.Security.Claims
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "დაბლოკილი IP-ები";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">IP @T("მისამართების ბლოკირება", "Address Blocking")</h2>
            <p class="text-slate-500 text-sm mt-1">@T("აკონტროლეთ არასასურველი წვდომა და იხილეთ ბლოკირების ისტორია", "Control unwanted access and view block history")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 sticky top-6">
                <h3 class="text-lg font-bold mb-4 text-slate-700 flex items-center">
                    <i data-lucide="shield-alert" class="w-5 h-5 mr-2 text-red-500"></i> @T("ახალი ბლოკი", "New Block")
                </h3>
                <form asp-action="Create" method="post" class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-1.5 ml-1">IP @T("მისამართი", "Address")</label>
                        <input type="text" name="ipAddress" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500 outline-none transition font-mono text-sm" placeholder="@T("მაგ:", "e.g:") 192.168.1.100" required />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-1.5 ml-1">@T("ბლოკირების მიზეზი", "Block Reason")</label>
                        <textarea name="reason" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500 outline-none transition text-sm" rows="3" placeholder="@T("მაგ: SPAM შეტევა, ბევრი მოთხოვნა...", "e.g: SPAM attack, rate limit exceeded...")"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3.5 rounded-xl transition shadow-lg shadow-red-500/30 flex items-center justify-center">
                        <i data-lucide="ban" class="w-4 h-4 mr-2"></i> @T("მისამართის დაბლოკვა", "Block Address")
                    </button>
                </form>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="bg-white shadow-sm border border-slate-200 rounded-3xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase text-[11px] font-black tracking-wider">
                                <th class="p-4 pl-6">IP @T("მისამართი / მიზეზი", "Address / Reason")</th>
                                <th class="p-4 text-center">@T("ტრაფიკის ისტორია", "Traffic History")</th>
                                <th class="p-4">@T("ვინ დაბლოკა", "Blocked By")</th>
                                <th class="p-4 pr-6 text-right">@T("მოქმედება", "Action")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!Model.Any())
                            {
                                <tr><td colspan="4" class="p-8 text-center text-slate-400">@T("დაბლოკილი მისამართები არ მოიძებნა", "No blocked addresses found")</td></tr>
                            }
                            
                            @{
                                var trafficDict = ViewBag.TrafficCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
                            }

                            @foreach (var ip in Model)
                            {
                                var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                                var isSuperAdmin = User.IsInRole("SuperAdmin");
                                var canUnlock = isSuperAdmin || ip.BlockedById == currentUserId;
                                var historyCount = trafficDict.ContainsKey(ip.IpAddress) ? trafficDict[ip.IpAddress] : 0;

                                <tr class="hover:bg-slate-50 transition">
                                    <td class="p-4 pl-6">
                                        <div class="font-mono text-sm text-red-600 font-bold">@ip.IpAddress</div>
                                        <div class="text-xs text-slate-500 mt-1 max-w-[200px] truncate" title="@ip.Reason">@(string.IsNullOrEmpty(ip.Reason) ? T("მიზეზი მითითებული არ არის", "No reason provided") : ip.Reason)</div>
                                    </td>
                                    <td class="p-4 text-center">
                                        @if (historyCount > 0)
                                        {
                                            <span class="inline-flex items-center px-2 py-1 rounded bg-orange-50 text-orange-600 text-xs font-bold border border-orange-100" title="@T("სისტემაში დაფიქსირებული მოთხოვნები", "Requests logged in system")">
                                                <i data-lucide="activity" class="w-3 h-3 mr-1"></i> @historyCount @T("შემოწმება", "checks")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">@T("ისტორიის გარეშე", "No history")</span>
                                        }
                                    </td>
                                    <td class="p-4">
                                        @if (ip.BlockedBy != null)
                                        {
                                            <div class="flex items-center" title="@ip.BlockedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")">
                                                <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px] font-bold mr-2 uppercase">
                                                    @(ip.BlockedBy?.UserName?.Substring(0, 1) ?? "U")
                                                </div>
                                                <span class="text-xs font-bold text-slate-700">@(ip.BlockedBy?.UserName ?? "Unknown")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-bold text-slate-400">@T("სისტემა", "System")</span>
                                        }
                                    </td>
                                    <td class="p-4 pr-6 text-right">
                                        @if (canUnlock)
                                        {
                                            <button type="button" onclick="openUnblockModal('@ip.Id', '@ip.IpAddress')" class="p-2 text-slate-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition shadow-sm border border-transparent hover:border-green-100" title="@T("ბლოკის მოხსნა", "Unblock")">
                                                <i data-lucide="unlock" class="w-5 h-5"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-slate-400 bg-slate-50 px-2 py-1 rounded border border-slate-100 uppercase font-bold">@T("მხოლოდ ნახვა", "View Only")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="unblockModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0 cursor-pointer" id="unblockModalBackdrop" onclick="closeUnblockModal()"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto pointer-events-none">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div id="unblockModalPanel" class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md border border-slate-100 opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95 pointer-events-auto">
                
                <div class="bg-slate-50 border-b border-slate-100 px-6 py-4 flex items-center justify-between">
                    <h3 class="text-lg font-bold text-slate-800 flex items-center" id="modal-title">
                        <span class="w-8 h-8 rounded-full bg-green-100 text-green-600 inline-flex items-center justify-center mr-3">
                            <i data-lucide="unlock" class="w-4 h-4"></i>
                        </span>
                        @T("ბლოკის მოხსნა", "Unblock IP")
                    </h3>
                    <button type="button" class="text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 p-2 rounded-lg transition" onclick="closeUnblockModal()">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <div class="px-6 py-6">
                    <p class="text-sm text-slate-600 leading-relaxed">
                        @T("ნამდვილად გსურთ ბლოკის მოხსნა IP მისამართისთვის:", "Are you sure you want to unblock the IP address:")
                        <strong id="unblockIpText" class="text-slate-800 font-mono bg-slate-100 px-1.5 py-0.5 rounded ml-1"></strong>@T("?", "?")
                    </p>
                </div>

                <div class="bg-slate-50 border-t border-slate-100 px-6 py-4 flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
                    <button type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-100 transition shadow-sm" onclick="closeUnblockModal()">
                        @T("გაუქმება", "Cancel")
                    </button>
                    <form id="unblockForm" method="post" action="">
                        <button type="submit" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-green-500 hover:bg-green-600 transition shadow-md shadow-green-500/30 flex items-center justify-center">
                            <i data-lucide="unlock" class="w-4 h-4 mr-2"></i> @T("დიახ, მოხსენი", "Yes, Unblock")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        const unblockModal = document.getElementById('unblockModal');
        const unblockBackdrop = document.getElementById('unblockModalBackdrop');
        const unblockPanel = document.getElementById('unblockModalPanel');
        const unblockForm = document.getElementById('unblockForm');
        const unblockIpText = document.getElementById('unblockIpText');

        function openUnblockModal(id, ip) {
            unblockForm.action = '/BlockedIps/Delete/' + id;
            unblockIpText.textContent = ip;

            unblockModal.classList.remove('hidden');
            
            setTimeout(() => {
                unblockBackdrop.classList.remove('opacity-0');
                unblockBackdrop.classList.add('opacity-100');
                
                unblockPanel.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                unblockPanel.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
            }, 10);
        }

        function closeUnblockModal() {
            unblockBackdrop.classList.remove('opacity-100');
            unblockBackdrop.classList.add('opacity-0');
            
            unblockPanel.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
            unblockPanel.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');

            setTimeout(() => {
                unblockModal.classList.add('hidden');
            }, 300);
        }
        
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape" && !unblockModal.classList.contains('hidden')) {
                closeUnblockModal();
            }
        });
    </script>
}