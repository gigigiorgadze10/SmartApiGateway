@using Microsoft.AspNetCore.Identity
@using SmartApiGateway.Data
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "მომხმარებლები";
}

<div class="container-fluid">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-slate-800">სისტემის მომხმარებლები</h2>
        <a href="/Account/Register" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition flex items-center shadow-md">
            <i data-lucide="user-plus" class="w-4 h-4 mr-2"></i> ახალი მომხმარებელი
        </a>
    </div>

    @* ... დანარჩენი ცხრილის კოდი იგივე რჩება ... *@
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase text-xs font-bold">
                    <th class="p-4">მომხმარებელი</th>
                    <th class="p-4">Email</th>
                    <th class="p-4 text-right">მოქმედება</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-4">
                            <div class="flex items-center">
                                <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold mr-3 uppercase">
                                    @(user.UserName?.Substring(0, 1) ?? "U")
                                </div>
                                <span class="font-semibold text-slate-700">@user.UserName</span>
                            </div>
                        </td>
                        <td class="p-4 text-slate-500 text-sm font-monospace">@user.Email</td>
                        <td class="p-4 text-right">
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('ნამდვილად გსურთ მომხმარებლის წაშლა?');">
                                <button type="submit" class="text-red-500 hover:text-red-700 p-2 rounded-lg hover:bg-red-50 transition">
                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>