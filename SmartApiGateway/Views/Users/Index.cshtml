@using Microsoft.AspNetCore.Identity
@using SmartApiGateway.Data
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "მომხმარებლები";
}

<div class="container-fluid">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">სისტემის მომხმარებლები</h2>
            <p class="text-slate-500 text-sm mt-1">მართეთ მომხმარებლის ანგარიშები და მათი უფლებები</p>
        </div>
        <a href="/Account/Register" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition flex items-center shadow-md">
            <i data-lucide="user-plus" class="w-4 h-4 mr-2"></i> ახალი მომხმარებელი
        </a>
    </div>

    @* შეტყობინებების ბლოკი *@
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-xl mb-6 shadow-sm flex items-center">
            <i data-lucide="check-circle" class="w-5 h-5 mr-2"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl mb-6 shadow-sm flex items-center">
            <i data-lucide="alert-circle" class="w-5 h-5 mr-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100 relative">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase text-xs font-bold">
                    <th class="p-4">მომხმარებელი</th>
                    <th class="p-4">Email</th>
                    <th class="p-4 text-right">მოქმედება</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-4">
                            <div class="flex items-center">
                                <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold mr-3 uppercase">
                                    @(user.UserName?.Substring(0, 1) ?? "U")
                                </div>
                                <div>
                                    <span class="font-semibold text-slate-700 block">@user.UserName</span>
                                    @if (user.UserName == User.Identity?.Name)
                                    {
                                        <span class="text-[10px] bg-blue-600 text-white px-1.5 py-0.5 rounded uppercase">თქვენ</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-slate-500 text-sm font-monospace">@user.Email</td>
                        <td class="p-4 text-right space-x-2">
                            @* რედაქტირების ღილაკი *@
                            <a asp-action="Edit" asp-route-id="@user.Id" class="inline-flex items-center justify-center text-blue-500 hover:text-blue-700 p-2 rounded-lg hover:bg-blue-50 transition" title="რედაქტირება">
                                <i data-lucide="edit-3" class="w-5 h-5"></i>
                            </a>

                            @* წაშლის ღილაკი - იძახებს ახალ მოდალს JS-ის ნაცვლად *@
                            <button type="button" onclick="openDeleteModal('@user.Id', '@user.UserName')" class="inline-flex items-center justify-center text-red-500 hover:text-red-700 p-2 rounded-lg hover:bg-red-50 transition" title="წაშლა">
                                <i data-lucide="trash-2" class="w-5 h-5"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="deleteModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0" id="modalBackdrop"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div id="modalPanel" class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md border border-slate-100 opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
                
                <div class="bg-slate-50 border-b border-slate-100 px-6 py-4 flex items-center justify-between">
                    <h3 class="text-lg font-bold text-slate-800 flex items-center" id="modal-title">
                        <div class="w-8 h-8 rounded-full bg-red-100 text-red-500 flex items-center justify-center mr-3">
                            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                        </div>
                        მომხმარებლის წაშლა
                    </h3>
                    <button type="button" class="text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 p-2 rounded-lg transition" onclick="closeDeleteModal()">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <div class="px-6 py-6">
                    <p class="text-sm text-slate-600 leading-relaxed">
                        ნამდვილად გსურთ მომხმარებლის <strong id="deleteUserName" class="text-slate-800"></strong> წაშლა? მონაცემები სამუდამოდ წაიშლება ბაზიდან და ამ მოქმედების უკან დაბრუნება შეუძლებელია.
                    </p>
                </div>

                <div class="bg-slate-50 border-t border-slate-100 px-6 py-4 flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
                    <button type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-100 transition shadow-sm" onclick="closeDeleteModal()">
                        გაუქმება
                    </button>
                    <form id="deleteForm" method="post" action="">
                        <button type="submit" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-red-500 hover:bg-red-600 transition shadow-md shadow-red-500/30">
                            დიახ, წაშალე
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lucide აიკონები
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // მოდალის მართვის ლოგიკა
        const modal = document.getElementById('deleteModal');
        const backdrop = document.getElementById('modalBackdrop');
        const panel = document.getElementById('modalPanel');
        const deleteForm = document.getElementById('deleteForm');
        const deleteUserName = document.getElementById('deleteUserName');

        function openDeleteModal(userId, userName) {
            // ფორმის Action-ის განახლება
            deleteForm.action = `/Users/Delete/${userId}`;
            deleteUserName.textContent = userName;

            // ვაჩვენებთ მოდალს
            modal.classList.remove('hidden');
            
            // პატარა დაყოვნება ანიმაციისთვის
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                backdrop.classList.add('opacity-100');
                
                panel.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                panel.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
            }, 10);
        }

        function closeDeleteModal() {
            // ვაბრუნებთ ანიმაციის კლასებს
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0');
            
            panel.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
            panel.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');

            // ანიმაციის დასრულების მერე ვმალავთ (Duration-ის მიხედვით)
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    </script>
}