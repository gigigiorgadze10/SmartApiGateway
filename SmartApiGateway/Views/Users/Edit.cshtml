@model SmartApiGateway.Models.EditUserViewModel
@{
    ViewData["Title"] = "მომხმარებლის რედაქტირება";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex items-center text-sm text-slate-500">
        <a href="/Users" class="hover:text-blue-600 transition font-medium">მომხმარებლები</a>
        <i data-lucide="chevron-right" class="w-4 h-4 mx-2"></i>
        <span class="font-bold text-slate-800">პროფილის რედაქტირება</span>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
        <div class="flex items-center mb-8 pb-6 border-b border-slate-100">
            <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center font-bold text-2xl uppercase shadow-inner mr-5">
                @(Model.UserName?.Substring(0, 1) ?? "U")
            </div>
            <div>
                <h2 class="text-2xl font-black text-slate-800">@Model.UserName</h2>
                <p class="text-slate-500 text-sm mt-1">ანგარიშის მართვა და წვდომის კონტროლი</p>
            </div>
        </div>

        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-4 rounded-xl"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Email" class="block text-sm font-bold text-slate-700 mb-2">ელ. ფოსტა <span class="text-xs text-slate-400 font-normal ml-2">(შეცვლა აკრძალულია)</span></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-5 h-5 text-slate-400"></i>
                        </div>
                        <input asp-for="Email" readonly class="w-full pl-10 p-3 bg-slate-100 text-slate-500 border border-slate-200 rounded-xl cursor-not-allowed outline-none font-mono text-sm" />
                    </div>
                </div>

                <div>
                    <label asp-for="UserName" class="block text-sm font-bold text-slate-700 mb-2"></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="user" class="w-5 h-5 text-slate-400"></i>
                        </div>
                        <input asp-for="UserName" class="w-full pl-10 p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
                    </div>
                    <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="pt-4">
                <label asp-for="SelectedRole" class="block text-sm font-bold text-slate-700 mb-2">სისტემური როლი (RBAC)</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="shield" class="w-5 h-5 text-amber-500"></i>
                    </div>
                    <select asp-for="SelectedRole" asp-items="@(new SelectList(Model.Roles))" class="w-full pl-10 p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition text-sm appearance-none cursor-pointer">
                        <option value="">-- აირჩიეთ როლი --</option>
                    </select>
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
                <p class="text-xs text-slate-400 mt-2">როლის შეცვლა ავტომატურად განაახლებს მომხმარებლის წვდომის უფლებებს მთელ სისტემაში.</p>
            </div>

            <div class="pt-6 flex justify-end space-x-3 border-t border-slate-100">
                <a href="/Users" class="px-6 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold rounded-xl transition">გაუქმება</a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 transition flex items-center">
                    <i data-lucide="save" class="w-4 h-4 mr-2"></i> ცვლილებების შენახვა
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}