@model SmartApiGateway.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "მომხმარებლის რედაქტირება";
}

<div class="max-w-2xl mx-auto mt-10 bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
    <h2 class="text-2xl font-bold text-slate-800 mb-6">როლის რედაქტირება: @Model.Email</h2>

    <form asp-action="Edit" method="post" class="space-y-6">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Email" />

        <div>
            <label class="block text-sm font-medium text-slate-600 mb-2">მიმდინარე როლი</label>
            <div class="flex gap-2">
                @if (!Model.CurrentRoles.Any())
                {
                    <span class="badge bg-slate-200 text-slate-700">როლი არ აქვს</span>
                }
                @foreach (var role in Model.CurrentRoles)
                {
                    <span class="px-3 py-1 bg-blue-100 text-blue-700 font-bold rounded-full text-sm">@role</span>
                }
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-600 mb-2">ახალი როლის მინიჭება</label>
            <select asp-for="SelectedRole" class="w-full p-3 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">-- აირჩიეთ ახალი როლი --</option>
                @foreach (var role in Model.AvailableRoles)
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
            <a asp-action="Index" class="px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition">გაუქმება</a>
            <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition shadow-md">
                შენახვა
            </button>
        </div>
    </form>
</div>