@model SmartApiGateway.Models.ApiEndpoint
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "მარშრუტის რედაქტირება";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center text-sm text-slate-500">
        <a href="/Endpoints" class="hover:text-blue-600 transition">@T("მარშრუტები", "Endpoints")</a>
        <i data-lucide="chevron-right" class="w-4 h-4 mx-2"></i>
        <span class="font-semibold text-slate-800">@T("რედაქტირება", "Edit")</span>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center">
            <span class="w-10 h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center mr-3">
                <i data-lucide="edit-2" class="w-5 h-5"></i>
            </span>
            @T("მარშრუტის რედაქტირება", "Edit Endpoint")
        </h2>

        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div>
                <label asp-for="RoutePath" class="block text-sm font-semibold text-slate-700 mb-2">@T("მარშრუტი (Route Path)", "Route Path")</label>
                <input asp-for="RoutePath" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none transition font-mono text-sm" />
                <span asp-validation-for="RoutePath" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="TargetUrl" class="block text-sm font-semibold text-slate-700 mb-2">@T("სამიზნე (Target URL)", "Target URL")</label>
                <textarea asp-for="TargetUrl" rows="2" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none transition font-mono text-sm"></textarea>
                <span asp-validation-for="TargetUrl" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-slate-700 mb-2">@T("აღწერა", "Description")</label>
                <input asp-for="Description" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none transition" />
            </div>

            <div class="flex items-center p-4 bg-slate-50 rounded-xl border border-slate-200">
                <div class="flex items-center h-5">
                    <input asp-for="IsActive" class="w-5 h-5 text-amber-600 bg-white border-slate-300 rounded focus:ring-amber-500 cursor-pointer" />
                </div>
                <div class="ml-3 text-sm">
                    <label asp-for="IsActive" class="font-bold text-slate-700 cursor-pointer">@T("მარშრუტი აქტიურია", "Endpoint is Active")</label>
                </div>
            </div>

            <div class="p-5 bg-red-50 rounded-xl border border-red-100">
                <div class="flex items-center mb-4">
                    <div class="flex items-center h-5">
                        <input asp-for="EnableRateLimiting" class="w-5 h-5 text-red-600 bg-white border-red-300 rounded focus:ring-red-500 cursor-pointer" />
                    </div>
                    <div class="ml-3 text-sm">
                        <label asp-for="EnableRateLimiting" class="font-bold text-red-800 cursor-pointer flex items-center">
                            <i data-lucide="shield-alert" class="w-4 h-4 mr-1"></i> @T("DDoS დაცვა & Auto-Ban", "Enable Auto-Ban & Protection")
                        </label>
                        <p class="text-red-600/80 text-xs mt-1">@T("ლიმიტის გადაჭარბებისას IP მისამართი ავტომატურად დაიბლოკება.", "IP will be automatically blocked if it exceeds the limit.")</p>
                    </div>
                </div>

                <div>
                    <label asp-for="RateLimitPerSecond" class="block text-sm font-semibold text-red-800 mb-2">@T("მაქსიმალური რექუესთი (წამში)", "Max Requests per Second")</label>
                    <input asp-for="RateLimitPerSecond" type="number" min="1" class="w-full p-3 bg-white border border-red-200 rounded-xl focus:ring-2 focus:ring-red-500 outline-none transition" />
                </div>
            </div>

            <div class="pt-4 flex justify-end space-x-3 border-t border-slate-100">
                <a asp-action="Index" class="px-6 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold rounded-xl transition">@T("გაუქმება", "Cancel")</a>
                <button type="submit" class="px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-lg shadow-amber-500/30 transition flex items-center">
                    <i data-lucide="save" class="w-4 h-4 mr-2"></i> @T("განახლება", "Update")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}