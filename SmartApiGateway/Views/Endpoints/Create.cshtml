@model SmartApiGateway.Models.ApiEndpoint
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "ახალი მარშრუტი";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center text-sm text-slate-500">
        <a href="/Endpoints" class="hover:text-blue-600 transition">@T("მარშრუტები", "Endpoints")</a>
        <i data-lucide="chevron-right" class="w-4 h-4 mx-2"></i>
        <span class="font-semibold text-slate-800">@T("დამატება", "Add")</span>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center">
            <span class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mr-3">
                <i data-lucide="route" class="w-5 h-5"></i>
            </span>
            @T("ახალი მარშრუტის შექმნა", "Create New Endpoint")
        </h2>

        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div>
                <label asp-for="RoutePath" class="block text-sm font-semibold text-slate-700 mb-2">@T("მარშრუტი (Route Path)", "Route Path")</label>
                <input asp-for="RoutePath" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition font-mono text-sm" placeholder="@T("მაგ:", "e.g:") /api/users" />
                <span asp-validation-for="RoutePath" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="TargetUrl" class="block text-sm font-semibold text-slate-700 mb-2">@T("სამიზნე (Target URL)", "Target URL")</label>
                <textarea asp-for="TargetUrl" rows="2" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition font-mono text-sm" placeholder="@T("მაგ:", "e.g:") https://server1.com/api, https://server2.com/api"></textarea>
                <span asp-validation-for="TargetUrl" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-slate-700 mb-2">@T("აღწერა", "Description")</label>
                <input asp-for="Description" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" />
            </div>

            <div class="flex items-center p-4 bg-slate-50 rounded-xl border border-slate-200">
                <div class="flex items-center h-5">
                    <input asp-for="IsActive" class="w-5 h-5 text-blue-600 bg-white border-slate-300 rounded focus:ring-blue-500 cursor-pointer" />
                </div>
                <div class="ml-3 text-sm">
                    <label asp-for="IsActive" class="font-bold text-slate-700 cursor-pointer">@T("მარშრუტი აქტიურია", "Endpoint is Active")</label>
                </div>
            </div>

            <div class="p-5 bg-slate-50 rounded-xl border border-slate-200">
                <h3 class="font-bold text-slate-800 mb-4 flex items-center">
                    <i data-lucide="shield-check" class="w-5 h-5 mr-2 text-green-600"></i>
                    @T("უსაფრთხოება და დაცვა", "Security & Protection")
                </h3>
                
                <div class="space-y-4">
                    <div class="p-4 bg-red-50 rounded-lg border border-red-100">
                        <div class="flex items-center mb-3">
                            <input asp-for="EnableRateLimiting" class="w-5 h-5 text-red-600 bg-white border-red-300 rounded focus:ring-red-500 cursor-pointer" />
                            <label asp-for="EnableRateLimiting" class="ml-3 font-bold text-red-800 cursor-pointer flex items-center">
                                <i data-lucide="shield-alert" class="w-4 h-4 mr-1"></i> @T("DDoS დაცვა (Rate Limiting)", "Enable DDoS Protection")
                            </label>
                        </div>
                        <div class="pl-8">
                            <label asp-for="RateLimitPerSecond" class="block text-xs font-semibold text-red-800 mb-1">@T("მაქსიმალური რექუესთი (წამში)", "Max Requests per Second")</label>
                            <input asp-for="RateLimitPerSecond" type="number" min="1" class="w-full p-2 text-sm bg-white border border-red-200 rounded-lg focus:ring-2 focus:ring-red-500 outline-none transition" />
                        </div>
                    </div>

                    <div class="p-4 bg-indigo-50 rounded-lg border border-indigo-100">
                        <div class="flex items-center">
                            <input asp-for="EnableSmartShield" class="w-5 h-5 text-indigo-600 bg-white border-indigo-300 rounded focus:ring-indigo-500 cursor-pointer" />
                            <div class="ml-3">
                                <label asp-for="EnableSmartShield" class="font-bold text-indigo-800 cursor-pointer flex items-center text-sm">
                                    <i data-lucide="brain" class="w-4 h-4 mr-1"></i> @T("Smart Shield (ქცევითი ანალიზი)", "Smart Shield (Behavioral Analysis)")
                                </label>
                                <p class="text-indigo-600/80 text-xs mt-1 leading-tight">@T("სისტემა დააკვირდება ჰაკერულ სკანირებებს (4xx ერორებს) და ავტომატურად დაბლოკავს საეჭვო IP-ებს.", "System will monitor for hacker scanning patterns and auto-ban suspicious IPs.")</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 bg-purple-50 rounded-lg border border-purple-100">
                        <div class="flex items-center">
                            <input asp-for="EnableMlAnomalyDetection" class="w-5 h-5 text-purple-600 bg-white border-purple-300 rounded focus:ring-purple-500 cursor-pointer" />
                            <div class="ml-3">
                                <label asp-for="EnableMlAnomalyDetection" class="font-bold text-purple-800 cursor-pointer flex items-center text-sm">
                                    <i data-lucide="activity" class="w-4 h-4 mr-1"></i> @T("ML Anomaly Detection (AI Spike Detection)", "ML Anomaly Detection (Spike Detection)")
                                </label>
                                <p class="text-purple-600/80 text-xs mt-1 leading-tight">@T("მანქანური სწავლების მოდელი შეისწავლის ტრაფიკის ნორმას და აღმოაჩენს უჩვეულო ნახტომებს (DDoS).", "Machine learning model learns traffic baselines and detects unusual spikes (DDoS).")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-4 flex justify-end space-x-3 border-t border-slate-100">
                <a asp-action="Index" class="px-6 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold rounded-xl transition">@T("გაუქმება", "Cancel")</a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 transition flex items-center">
                    <i data-lucide="save" class="w-4 h-4 mr-2"></i> @T("შენახვა", "Save")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}