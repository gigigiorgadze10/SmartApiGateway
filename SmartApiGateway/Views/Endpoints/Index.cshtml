@model IEnumerable<SmartApiGateway.Models.ApiEndpoint>
@using System.Security.Claims
@{
    ViewData["Title"] = "მარშრუტები";
}

<div class="container-fluid max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">API ენდპოინტები</h2>
            <p class="text-slate-500 text-sm mt-1">მართეთ ტრაფიკის მარშრუტიზაცია და Load Balancing</p>
        </div>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl transition flex items-center font-semibold shadow-lg shadow-blue-500/30">
            <i data-lucide="plus" class="w-5 h-5 mr-2"></i> ახალი მარშრუტი
        </a>
    </div>

    <div class="bg-white shadow-sm border border-slate-200 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-200 text-slate-500 uppercase text-[11px] font-black tracking-wider">
                        <th class="p-4 pl-6">მარშრუტი</th>
                        <th class="p-4">Target URL</th>
                        <th class="p-4 text-center">სტატუსი</th>
                        <th class="p-4">ავტორი</th>
                        <th class="p-4 pr-6 text-right">მოქმედება</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="p-8 text-center text-slate-400">მარშრუტები ჯერ არ დამატებულა</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                        var isSuperAdmin = User.IsInRole("SuperAdmin");
                        var canEdit = isSuperAdmin || item.CreatedById == currentUserId;

                        <tr class="hover:bg-slate-50/80 transition duration-150">
                            <td class="p-4 pl-6">
                                <span class="font-mono text-sm text-blue-600 bg-blue-50 px-2 py-1 rounded-md font-semibold border border-blue-100">@item.RoutePath</span>
                            </td>
                            <td class="p-4 text-sm text-slate-600 max-w-xs truncate" title="@item.TargetUrl">@item.TargetUrl</td>
                            <td class="p-4 text-center">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-green-100 text-green-700 uppercase">აქტიური</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 uppercase">გათიშული</span>
                                }
                            </td>
                            <td class="p-4">
                                @if (item.CreatedBy != null)
                                {
                                    <div class="flex items-center">
                                        <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-[10px] font-bold mr-2 uppercase">
                                            @(item.CreatedBy?.UserName?.Substring(0, 1) ?? "U")
                                        </div>
                                        <span class="text-xs font-bold text-slate-600">@(item.CreatedBy?.UserName ?? "Unknown")</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs font-bold text-slate-400">სისტემა</span>
                                }
                            </td>
                            <td class="p-4 pr-6 text-right space-x-1">
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="inline-block p-2 text-slate-400 hover:text-amber-500 hover:bg-amber-50 rounded-lg transition" title="რედაქტირება">
                                        <i data-lucide="edit-2" class="w-4 h-4"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('წავშალოთ მარშრუტი?');">
                                        <button type="submit" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" title="წაშლა">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-[10px] text-slate-400 bg-slate-50 px-2 py-1 rounded border border-slate-100 uppercase font-bold">მხოლოდ ნახვა</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>