@model IEnumerable<SmartApiGateway.Models.ApiEndpoint>
@{
    ViewData["Title"] = "API ენდპოინტები";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-hdd-network"></i> მარშრუტების (Endpoints) მართვა</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> ახლის დამატება</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">შემომავალი მარშრუტი</th>
                        <th>სამიზნე URL</th>
                        <th>სტატუსი</th>
                        <th>აღწერა</th>
                        <th class="text-end pe-4">მოქმედება</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-bold text-primary">@item.RoutePath</td>
                            <td class="font-monospace">@item.TargetUrl</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">აქტიური</span>
                                }
                                else
                                {

                                    <span class="badge bg-danger">გათიშული</span>
                                }
                            </td>
                            <td>@item.Description</td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('ნამდვილად გსურთ წაშლა?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> წაშლა</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>