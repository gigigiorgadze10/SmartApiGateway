@model SmartApiGateway.Data.ApplicationUser
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "პარამეტრები";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}

<div class="max-w-4xl mx-auto">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-800">@T("ანგარიშის პარამეტრები", "Account Settings")</h2>
        <p class="text-slate-500 text-sm mt-1">@T("მართეთ თქვენი პროფილი და უსაფრთხოება", "Manage your profile and security")</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl flex items-center">
            <i data-lucide="check-circle" class="w-5 h-5 mr-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl flex items-center">
            <i data-lucide="alert-circle" class="w-5 h-5 mr-2"></i> @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <i data-lucide="user" class="w-5 h-5 mr-2 text-blue-500"></i> @T("პირადი მონაცემები", "Personal Info")
            </h3>
            <form asp-action="UpdateProfile" method="post" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("ელ. ფოსტა", "Email") <span class="text-xs font-normal text-slate-400 ml-1">(@T("შეცვლა აკრძალულია", "Cannot be changed"))</span></label>
                    <input type="text" value="@Model.Email" readonly class="w-full p-3 bg-slate-100 text-slate-500 border border-slate-200 rounded-xl cursor-not-allowed outline-none font-mono text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("მომხმარებლის სახელი", "Username")</label>
                    <input type="text" name="userName" value="@Model.UserName" required class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
                </div>
                <button type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 transition">@T("განახლება", "Update")</button>
            </form>
        </div>

        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <i data-lucide="lock" class="w-5 h-5 mr-2 text-amber-500"></i> @T("უსაფრთხოება", "Security")
            </h3>
            <form asp-action="ChangePassword" method="post" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("მიმდინარე პაროლი", "Current Password")</label>
                    <input type="password" name="oldPassword" required class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none transition text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">@T("ახალი პაროლი", "New Password")</label>
                    <input type="password" name="newPassword" required class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none transition text-sm" />
                </div>
                <button type="submit" class="w-full px-6 py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-lg shadow-amber-500/30 transition">@T("პაროლის შეცვლა", "Change Password")</button>
            </form>
        </div>
    </div>
</div>