@using Microsoft.AspNetCore.Localization
@{
    Layout = null;
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}
<!DOCTYPE html>
<html lang="@(isEn ? "en" : "ka")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Synox Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Noto Sans Georgian', sans-serif;
        }

        .bg-grid {
        background-size: 40px 40px;
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 bg-grid min-h-screen flex flex-col relative">

    <nav class="absolute top-0 left-0 right-0 p-4 sm:p-6 flex justify-between items-center z-10 max-w-7xl mx-auto w-full">
        <div class="flex items-center space-x-2">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg">
                <i data-lucide="network" class="w-4 h-4 sm:w-6 sm:h-6"></i>
            </div>
            <span class="text-lg sm:text-xl font-black text-slate-800 tracking-tight">Synox<span class="text-blue-600"> Gateway</span></span>
        </div>
        <div class="flex items-center gap-2 sm:gap-4">
            <form asp-action="SetLanguage" method="post" class="m-0 flex items-center bg-white border border-slate-200 rounded-lg p-1 shadow-sm">
                <input type="hidden" name="returnUrl" value="/" />
                <button type="submit" name="culture" value="ka" class="px-2 py-1 text-xs font-bold rounded @(!isEn ? "bg-slate-100 text-blue-600" : "text-slate-500 hover:bg-slate-50") transition">GE</button>
                <button type="submit" name="culture" value="en" class="px-2 py-1 text-xs font-bold rounded @(isEn ? "bg-slate-100 text-blue-600" : "text-slate-500 hover:bg-slate-50") transition">EN</button>
            </form>

            <a href="/Home/Documentation" class="flex bg-white text-slate-600 hover:text-blue-600 hover:bg-slate-50 font-semibold py-1.5 px-3 sm:py-2 sm:px-4 rounded-lg shadow-sm border border-slate-200 transition items-center text-sm sm:text-base">
                <i data-lucide="book-open" class="w-4 h-4 sm:mr-2"></i> <span class="hidden sm:inline">@T("დოკუმენტაცია", "Docs")</span>
            </a>
        </div>
    </nav>

    <div class="flex-grow flex flex-col justify-center items-center text-center px-4 pt-32 pb-20">
        <div class="inline-flex items-center space-x-2 bg-slate-900/5 border border-slate-200/50 text-slate-700 px-4 py-2 rounded-full text-sm font-bold mb-8 shadow-sm backdrop-blur-md">
            <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
            <span>@T("სისტემა აქტიურია", "System Active")</span>
        </div>

        <h1 class="text-4xl md:text-7xl font-black text-slate-900 mb-6 max-w-4xl leading-tight">
            @T("მართე შენი", "Manage your") <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">API @T("ტრაფიკი", "Traffic")</span><br class="hidden sm:block" /> @T("ერთი წერტილიდან", "from one place")
        </h1>

        <p class="text-base md:text-xl text-slate-500 max-w-2xl mb-10 leading-relaxed">
            @T("უსაფრთხო, სწრაფი და მოქნილი შუალედური ფენა თქვენს მიკროსერვისებსა და კლიენტებს შორის. აკონტროლეთ მარშრუტიზაცია, დაიცავით სერვერები და დააკვირდით სტატისტიკას ლაივ რეჟიმში.", "Secure, fast, and flexible middleware between your microservices and clients. Control routing, protect servers, and monitor statistics in real-time.")
        </p>

        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <a href="/Account/Login" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl shadow-lg transition flex items-center justify-center w-full sm:w-auto">
                <i data-lucide="layout-dashboard" class="w-5 h-5 mr-2"></i> @T("მართვის პანელი", "Dashboard Login")
            </a>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 pb-24 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-lg flex items-center justify-center mb-6">
                <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold mb-3">@T("სრული უსაფრთხოება", "Full Security")</h3>
            <p class="text-slate-500 text-sm leading-relaxed">@T("IP ბლოკირება და Rate Limiting თქვენი სერვერების დასაცავად.", "IP blocking and Rate Limiting to protect your servers.")</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="w-12 h-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mb-6">
                <i data-lucide="route" class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold mb-3">@T("დინამიური მარშრუტიზაცია", "Dynamic Routing")</h3>
            <p class="text-slate-500 text-sm leading-relaxed">@T("Load Balancing და ენდპოინტების მართვა სერვერის გათიშვის გარეშე.", "Load Balancing and endpoint management without downtime.")</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-lg flex items-center justify-center mb-6">
                <i data-lucide="activity" class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold mb-3">@T("ლაივ ანალიტიკა", "Live Analytics")</h3>
            <p class="text-slate-500 text-sm leading-relaxed">@T("SignalR-ზე დაფუძნებული რეალური დროის ტრაფიკის მონიტორინგი.", "SignalR based real-time traffic monitoring.")</p>
        </div>
    </div>

    <script>lucide.createIcons();</script></body>
</html>