@{
    Layout = null; 
}
<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart API Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Noto Sans Georgian', sans-serif; }
        .bg-grid { background-size: 40px 40px; background-image: linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px); }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 bg-grid min-h-screen flex flex-col relative">

    <nav class="absolute top-0 left-0 right-0 p-6 flex justify-between items-center z-10 max-w-7xl mx-auto w-full">
        <div class="flex items-center space-x-2">
            <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg">
                <i data-lucide="network"></i>
            </div>
            <span class="text-xl font-black text-slate-800 tracking-tight">Smart Gateway</span>
        </div>
        <div>
            <a href="/Home/Documentation" class="bg-white text-slate-600 hover:text-blue-600 hover:bg-slate-50 font-semibold py-2.5 px-6 rounded-lg shadow-sm border border-slate-200 transition flex items-center">
                <i data-lucide="book-open" class="w-4 h-4 mr-2"></i> დოკუმენტაცია
            </a>
        </div>
    </nav>

    <div class="flex-grow flex flex-col justify-center items-center text-center px-4 pt-32 pb-20">
        <div class="inline-flex items-center space-x-2 bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-bold mb-8 shadow-sm">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500"></span>
            </span>
            <span>სისტემა აქტიურია (v1.0)</span>
        </div>
        
        <h1 class="text-5xl md:text-7xl font-black text-slate-900 mb-6 max-w-4xl leading-tight">
            მართე შენი <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">API ტრაფიკი</span> ერთი წერტილიდან
        </h1>
        
        <p class="text-lg md:text-xl text-slate-500 max-w-2xl mb-10 leading-relaxed">
            უსაფრთხო, სწრაფი და მოქნილი შუალედური ფენა თქვენს მიკროსერვისებსა და კლიენტებს შორის. 
            აკონტროლეთ მარშრუტიზაცია, დაიცავით სერვერები და დააკვირდით სტატისტიკას ლაივ რეჟიმში.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
            <a href="/Account/Login" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl shadow-lg transition flex items-center justify-center">
                <i data-lucide="layout-dashboard" class="w-5 h-5 mr-2"></i> მართვის პანელი
            </a>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 pb-24 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-lg flex items-center justify-center mb-6">
                <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold mb-3">სრული უსაფრთხოება</h3>
            <p class="text-slate-500 text-sm">IP ბლოკირება და Rate Limiting თქვენი სერვერების დასაცავად.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="w-12 h-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mb-6">
                <i data-lucide="route" class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold mb-3">დინამიური მარშრუტიზაცია</h3>
            <p class="text-slate-500 text-sm">Load Balancing და ენდპოინტების მართვა სერვერის გათიშვის გარეშე.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition">
            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-lg flex items-center justify-center mb-6">
                <i data-lucide="activity" class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold mb-3">ლაივ ანალიტიკა</h3>
            <p class="text-slate-500 text-sm">SignalR-ზე დაფუძნებული რეალური დროის ტრაფიკის მონიტორინგი.</p>
        </div>
    </div>

    <script>lucide.createIcons();</script>
</body>
</html>