@model IEnumerable<SmartApiGateway.Models.TrafficLog>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>სისტემის მონიტორინგი</h2>
        <span class="badge bg-success fs-6"><i class="bi bi-circle-fill me-2"></i>Gateway Active</span>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-sm h-100 rounded-4 border-0">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2 text-white-50">ჯამური მოთხოვნები</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.TotalRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info shadow-sm h-100 rounded-4 border-0">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2 text-white-50">საშ. პასუხის დრო</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.AvgLatency <span class="fs-5">ms</span></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning shadow-sm h-100 rounded-4 border-0">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2 text-dark-50">შეცდომები (4xx-5xx)</h6>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@ViewBag.ErrorsCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger shadow-sm h-100 rounded-4 border-0">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2 text-white-50">დაბლოკილი IP-ები</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.BlockedCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 text-secondary"><i class="bi bi-activity me-2"></i>ბოლო აქტივობა (Live)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">დრო</th>
                            <th>IP მისამართი</th>
                            <th>მეთოდი</th>
                            <th>მისამართი (URL)</th>
                            <th>სტატუსი</th>
                            <th class="pe-4 text-end">ხანგრძლივობა</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var log in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@log.CreatedAt.ToString("HH:mm:ss")</td>
                                    <td><span class="font-monospace bg-light px-2 py-1 rounded">@log.IpAddress</span></td>
                                    <td>
                                        @if (log.HttpMethod == "GET")
                                        {
                                            <span class="badge bg-success rounded-pill px-3">GET</span>
                                        }
                                        else if (log.HttpMethod == "POST")
                                        {

                                            <span class="badge bg-warning text-dark rounded-pill px-3">POST</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary rounded-pill px-3">@log.HttpMethod</span>
                                        }
                                    </td>
                                    <td class="text-truncate" style="max-width: 250px;">@log.RequestedUrl</td>
                                    <td>
                                        @if (log.StatusCode == 200 || log.StatusCode == 201)
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>@log.StatusCode</span>
                                        }
                                        else if (log.StatusCode == 429)
                                        {

                                            <span class="text-warning fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>429 Limit</span>
                                        }
                                        else
                                        {

                                            <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i>@log.StatusCode</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end font-monospace">@log.ResponseTimeMs ms</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">ტრაფიკი ჯერ არ დაფიქსირებულა. გაუშვით მოთხოვნები.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>