@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = "API Sandbox";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}

<div class="max-w-5xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-slate-800 flex items-center">
            <span class="bg-slate-900 text-white w-12 h-12 flex items-center justify-center rounded-2xl mr-4 shadow-lg shadow-slate-900/20">
                <i data-lucide="flask-conical" class="w-6 h-6 text-emerald-400"></i>
            </span>
            @Html.Raw(T("API ტესტერი (Sandbox)", "API Sandbox Tester"))
        </h1>
        <p class="text-slate-500 mt-2 ml-16">@Html.Raw(T("გაგზავნეთ სატესტო მოთხოვნები თქვენს მიკროსერვისებთან და შეამოწმეთ პასუხები.", "Send test requests to your microservices and inspect responses."))</p>
    </div>

    <!-- Request Section -->
    <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 mb-6">
        <div class="flex flex-col md:flex-row gap-4 mb-6">
            
            <!-- გალამაზებული Dropdown -->
            <div class="relative w-full md:w-32 shrink-0">
                <select id="reqMethod" class="appearance-none bg-slate-50 border border-slate-200 text-slate-800 text-sm font-black rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 block w-full p-3 pr-10 outline-none cursor-pointer transition">
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                    <option value="DELETE">DELETE</option>
                    <option value="PATCH">PATCH</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </div>
            </div>
            
            <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                    <i data-lucide="globe" class="w-5 h-5 text-slate-400"></i>
                </div>
                <input type="text" id="reqUrl" class="bg-slate-50 border border-slate-200 text-slate-800 text-sm rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 block w-full pl-12 p-3 outline-none font-mono" placeholder="https://api.yoursystem.com/v1/users" value="https://jsonplaceholder.typicode.com/todos/1">
            </div>
            
            <button id="sendBtn" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl px-8 py-3 shadow-lg shadow-emerald-500/30 transition flex items-center justify-center min-w-[140px]">
                <span id="btnText">@Html.Raw(T("გაგზავნა", "Send"))</span>
                <i data-lucide="send" id="btnIcon" class="w-4 h-4 ml-2"></i>
                <i data-lucide="loader-2" id="btnLoader" class="w-4 h-4 ml-2 animate-spin hidden"></i>
            </button>
        </div>

        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">@Html.Raw(T("Request Body (JSON)", "Request Body (JSON)"))</label>
            <textarea id="reqBody" rows="5" class="block p-4 w-full text-sm text-slate-800 bg-slate-50 rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none font-mono custom-scrollbar" placeholder='{&#10;  "key": "value"&#10;}'></textarea>
        </div>
    </div>

    <!-- Response Section -->
    <div id="responseSection" class="bg-[#0a0a0a] rounded-3xl p-6 shadow-xl border border-slate-800 hidden relative">
        <div class="flex flex-wrap items-center justify-between mb-4 border-b border-slate-800 pb-4 gap-4">
            <h3 class="text-white font-bold flex items-center">
                <i data-lucide="terminal-square" class="w-5 h-5 mr-2 text-slate-400"></i> Response
            </h3>
            <div class="flex items-center space-x-4 text-sm font-mono">
                <div class="flex items-center">
                    <span class="text-slate-500 mr-2">Status:</span>
                    <span id="resStatus" class="font-bold px-2 py-0.5 rounded"></span>
                </div>
                <div class="flex items-center">
                    <span class="text-slate-500 mr-2">Time:</span>
                    <span id="resTime" class="text-cyan-400 font-bold"></span>
                </div>
            </div>
        </div>
        
        <div class="relative group">
            <button onclick="copyResponse()" class="absolute top-2 right-2 p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg opacity-0 group-hover:opacity-100 transition" title="Copy JSON">
                <i data-lucide="copy" class="w-4 h-4"></i>
            </button>
            <pre class="m-0"><code id="resBody" class="block p-4 text-sm text-emerald-400 font-mono overflow-x-auto custom-scrollbar" style="max-height: 400px;"></code></pre>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
</style>

@section Scripts {
    <script>
        const btnSend = document.getElementById('sendBtn');
        const btnText = document.getElementById('btnText');
        const btnIcon = document.getElementById('btnIcon');
        const btnLoader = document.getElementById('btnLoader');
        const responseSection = document.getElementById('responseSection');
        const resBody = document.getElementById('resBody');
        const resStatus = document.getElementById('resStatus');
        const resTime = document.getElementById('resTime');

        btnSend.addEventListener('click', async () => {
            const method = document.getElementById('reqMethod').value;
            const url = document.getElementById('reqUrl').value;
            let body = document.getElementById('reqBody').value;

            if (!url) {
                alert('Please enter a valid URL');
                return;
            }

            // UI Loading State (Html.Raw JS-ში)
            btnText.innerHTML = '@Html.Raw(T("იგზავნება...", "Sending..."))';
            btnIcon.classList.add('hidden');
            btnLoader.classList.remove('hidden');
            btnSend.disabled = true;
            btnSend.classList.add('opacity-75', 'cursor-not-allowed');

            const startTime = performance.now();
            
            try {
                const options = {
                    method: method,
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                };

                if (method !== 'GET' && method !== 'HEAD' && body) {
                    options.body = body;
                }

                const response = await fetch(url, options);
                const endTime = performance.now();
                const duration = Math.round(endTime - startTime);

                // სტატუსის ფერები
                resStatus.textContent = `${response.status} ${response.statusText}`;
                resStatus.className = 'font-bold px-2 py-0.5 rounded text-sm ';
                if(response.status >= 200 && response.status < 300) resStatus.classList.add('bg-emerald-500/20', 'text-emerald-400');
                else if(response.status >= 400 && response.status < 500) resStatus.classList.add('bg-amber-500/20', 'text-amber-400');
                else resStatus.classList.add('bg-red-500/20', 'text-red-400');

                resTime.textContent = `${duration} ms`;

                // JSON ენკოდინგი და პრინტი
                const contentType = response.headers.get("content-type");
                let resultText = "";
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const json = await response.json();
                    resultText = JSON.stringify(json, null, 2);
                } else {
                    resultText = await response.text();
                }

                resBody.textContent = resultText;
                responseSection.classList.remove('hidden');

            } catch (error) {
                resStatus.textContent = `ERROR`;
                resStatus.className = 'font-bold px-2 py-0.5 rounded text-sm bg-red-500/20 text-red-400';
                resTime.textContent = `- ms`;
                resBody.textContent = error.toString();
                responseSection.classList.remove('hidden');
            } finally {
                // UI Reset
                btnText.innerHTML = '@Html.Raw(T("გაგზავნა", "Send"))';
                btnIcon.classList.remove('hidden');
                btnLoader.classList.add('hidden');
                btnSend.disabled = false;
                btnSend.classList.remove('opacity-75', 'cursor-not-allowed');
            }
        });

        function copyResponse() {
            navigator.clipboard.writeText(resBody.textContent).then(() => {
                const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 });
                Toast.fire({ icon: 'success', title: 'Copied to clipboard!' });
            });
        }
    </script>
}