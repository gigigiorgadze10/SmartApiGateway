@using Microsoft.AspNetCore.Localization
@{
    Layout = null;
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isEn = requestCulture?.RequestCulture.UICulture.Name == "en";
    string T(string ka, string en) => isEn ? en : ka;
}
<!DOCTYPE html>
<html lang="@(isEn ? "en" : "ka")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T("დოკუმენტაცია", "Documentation") - Synox Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Noto Sans Georgian', sans-serif;
        }</style>
    </head>
    <body class="bg-slate-50 text-slate-800 min-h-screen">

        <nav class="bg-white border-b border-slate-200 p-4 sticky top-0 z-50">
            <div class="max-w-5xl mx-auto flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-blue-600 rounded flex items-center justify-center text-white">
                        <i data-lucide="network" class="w-4 h-4"></i>
                    </div>
                    <span class="font-bold text-slate-800 tracking-wide">Synox<span class="text-blue-600"> Gateway</span></span>
                </div>

                <div class="flex items-center gap-4">
                    <form asp-action="SetLanguage" method="post" class="m-0 flex items-center bg-slate-50 border border-slate-200 rounded-lg p-1 shadow-sm">
                        <input type="hidden" name="returnUrl" value="/Home/Documentation" />
                        <button type="submit" name="culture" value="ka" class="px-2 py-1 text-xs font-bold rounded @(!isEn ? "bg-white shadow text-blue-600" : "text-slate-500")">GE</button>
                        <button type="submit" name="culture" value="en" class="px-2 py-1 text-xs font-bold rounded @(isEn ? "bg-white shadow text-blue-600" : "text-slate-500")">EN</button>
                    </form>

                    <a href="/" class="text-sm font-medium text-slate-500 hover:text-blue-600 flex items-center transition bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg">
                        <i data-lucide="arrow-left" class="w-4 h-4 mr-1"></i> <span class="hidden sm:inline">@T("მთავარ გვერდზე დაბრუნება", "Back to Home")</span>
                    </a>
                </div>
            </div>
        </nav>

        <main class="max-w-5xl mx-auto py-10 px-4">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">

                <header class="mb-12 border-b border-slate-100 pb-8">
                    <h1 class="text-3xl md:text-5xl font-black text-slate-900 mb-4 tracking-tight">@T("ტექნიკური დოკუმენტაცია", "Technical Documentation")</h1>
                    <p class="text-lg text-slate-500 leading-relaxed max-w-3xl">
                        @T("გაეცანით სისტემის არქიტექტურას, Polyglot მონაცემთა მართვას და კიბერუსაფრთხოების სამშრიან (AI, Heuristics, Rate-Limiting) მექანიზმებს. ეს დოკუმენტაცია დაგეხმარებათ Gateway-ს სწორად კონფიგურაციაში.", "Explore the system architecture, Polyglot data management, and the three-layered cybersecurity mechanisms (AI, Heuristics, Rate-Limiting). This documentation will help you configure the Gateway correctly.")
                    </p>
                </header>

                <div class="space-y-16">

                    <section>
                        <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center">
                            <i data-lucide="layers" class="w-6 h-6 mr-3 text-blue-500"></i> @T("არქიტექტურა და ტექნოლოგიური სტეკი", "Architecture & Tech Stack")
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 hover:border-blue-300 transition-colors">
                                <h3 class="font-bold text-slate-800 mb-2 flex items-center"><i data-lucide="server" class="w-4 h-4 mr-2 text-slate-500"></i> Core Framework</h3>
                                <p class="text-sm text-slate-600">@T("ASP.NET Core 8.0 (MVC). უზრუნველყოფს მოთხოვნების სწრაფ და პარალელურ დამუშავებასა და Multi-tenant მართვას.", "ASP.NET Core 8.0 (MVC). Ensures fast, concurrent request processing and Multi-tenant management.")</p>
                            </div>
                            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 hover:border-blue-300 transition-colors">
                                <h3 class="font-bold text-slate-800 mb-2 flex items-center"><i data-lucide="database" class="w-4 h-4 mr-2 text-slate-500"></i> Polyglot Persistence</h3>
                                <p class="text-sm text-slate-600">@T("ვიყენებთ ორ მონაცემთა ბაზას: Entity Framework (PostgreSQL/SQLServer) რელაციური კონფიგურაციებისთვის და MongoDB ტრაფიკის მილიონობით ლოგის სწრაფი (High-throughput) ჩაწერისთვის.", "We use two databases: Entity Framework (PostgreSQL/SQLServer) for relational configurations, and MongoDB for high-throughput traffic logging.")</p>
                            </div>
                            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 hover:border-blue-300 transition-colors">
                                <h3 class="font-bold text-slate-800 mb-2 flex items-center"><i data-lucide="activity" class="w-4 h-4 mr-2 text-slate-500"></i> Real-Time Observability</h3>
                                <p class="text-sm text-slate-600">@T("SignalR WebSockets გამოიყენება Dashboard-ზე ტრაფიკისა და უსაფრთხოების ალერტების (Alerts) მყისიერი (Live) გამოტანისთვის გვერდის დარეფრეშების გარეშე.", "SignalR WebSockets are used for instant display of traffic and security alerts on the Dashboard without page refreshes.")</p>
                            </div>
                            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 hover:border-blue-300 transition-colors">
                                <h3 class="font-bold text-slate-800 mb-2 flex items-center"><i data-lucide="brain" class="w-4 h-4 mr-2 text-slate-500"></i> Local Machine Learning</h3>
                                <p class="text-sm text-slate-600">@T("Microsoft ML.NET ინტეგრაცია ლოკალურ სერვერზე ფონური სერვისების სახით დროითი სერიების (Time-Series) ანალიზისთვის.", "Microsoft ML.NET integration on the local server as background services for Time-Series analysis.")</p>
                            </div>
                        </div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center">
                            <i data-lucide="shield-alert" class="w-6 h-6 mr-3 text-red-500"></i> @T("უსაფრთხოების 3-შრიანი ფარი (WAF)", "3-Layer Security Shield (WAF)")
                        </h2>

                        <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-200 before:to-transparent">

                            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-slate-100 text-slate-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">1</div>
                                <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-xl border border-slate-200 bg-white shadow-sm group-hover:border-blue-300 transition">
                                    <div class="flex items-center mb-2">
                                        <i data-lucide="timer" class="w-4 h-4 text-orange-500 mr-2"></i>
                                        <h4 class="font-bold text-slate-800">Rate Limiting (Volumetric DDoS)</h4>
                                    </div>
                                    <p class="text-sm text-slate-600">@T("პირველი ხაზი. თუ კლიენტი გადააჭარბებს დადგენილ ლიმიტს (მაგ: 10 მოთხოვნა 1 წამში), მიდლვეარი მას მყისიერად ბლოკავს (429 Too Many Requests) და ამატებს შავ სიაში.", "First line of defense. If a client exceeds the set limit (e.g., 10 req/sec), the middleware blocks them instantly (429) and adds them to the blacklist.")</p>
                                </div>
                            </div>

                            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-slate-100 text-slate-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">2</div>
                                <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-xl border border-slate-200 bg-white shadow-sm group-hover:border-blue-300 transition">
                                    <div class="flex items-center mb-2">
                                        <i data-lucide="search" class="w-4 h-4 text-purple-500 mr-2"></i>
                                        <h4 class="font-bold text-slate-800">Smart Shield (Heuristics)</h4>
                                    </div>
                                    <p class="text-sm text-slate-600">@T("ქცევითი ანალიზი ფონურ რეჟიმში. ამოწმებს ლოგებს საეჭვო აქტივობაზე. თუ IP აგზავნის ბევრ 4xx (განსაკუთრებით 404/401) მოთხოვნას, სისტემა მას აღიქვამს როგორც 'Vulnerability Scanner' და ბლოკავს.", "Behavioral analysis in the background. If an IP sends many 4xx errors (especially 404/401), the system recognizes it as a Vulnerability Scanner and blocks it.")</p>
                                </div>
                            </div>

                            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-slate-100 text-slate-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">3</div>
                                <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-xl border border-blue-100 bg-blue-50 shadow-sm group-hover:border-blue-400 transition">
                                    <div class="flex items-center mb-2">
                                        <i data-lucide="bot" class="w-4 h-4 text-blue-600 mr-2"></i>
                                        <h4 class="font-bold text-blue-900">ML Anomaly Detection (AI)</h4>
                                    </div>
                                    <p class="text-sm text-blue-800">@T("ყველაზე ინტელექტუალური შრე. ML.NET-ის SSA (Singular Spectrum Analysis) ალგორითმი სწავლობს ტრაფიკის ბეისლაინს ბოლო 60 წუთის განმავლობაში და 99% სიზუსტით იჭერს არაბუნებრივ ტრაფიკულ ნახტომებს (Low and Slow Attacks).", "The most intelligent layer. ML.NET's SSA algorithm learns the traffic baseline over the last 60 minutes and catches unnatural traffic spikes with 99% confidence.")</p>
                                </div>
                            </div>

                        </div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center border-b border-slate-100 pb-2">
                            <i data-lucide="git-merge" class="w-6 h-6 mr-3 text-emerald-500"></i> @T("მუშაობის პრინციპი (Pipeline)", "Request Pipeline")
                        </h2>

                        <div class="bg-slate-800 rounded-xl p-6 text-slate-300 font-mono text-sm overflow-x-auto border border-slate-700 shadow-inner">
                            <div class="flex items-center space-x-2 text-slate-400 mb-4">
                                <i data-lucide="terminal" class="w-4 h-4"></i>
                                <span>gateway-pipeline.flow</span>
                            </div>
                            <pre><code>Client Request ---> [ GatewayMiddleware ]
                       |
                       +---> Is IP Blocked? (Database/Cache) ---> Yes -> 403 Forbidden
                       |
                       +---> Rate Limit Exceeded? ---> Yes -> 429 Too Many Requests -> Add to Blocklist
                       |
                       v
              [ Find Endpoint by Route ] ---> Target URL (e.g. localhost:5000/api)
                       |
                       v
               [ HttpClient Proxying ] ---> Send request to internal server
                       |
                       v
            [ Response Received & Timed ]
                       |
                       +---> Save TrafficLog to MongoDB
                       |
                       +---> Broadcast to UI via SignalR
                       |
                       v
                  Client Response

[ Background Workers ]
 ├─> SmartShieldService: Every 30s analyzes Mongo for 4xx scans.
 └─> MlAnomalyDetection: Every 60s builds Time-Series & predicts Spikes.</code></pre>
                        </div>
                    </section>

                </div>
            </div>
        </main>

        <script>lucide.createIcons();</script>
    </body></html>