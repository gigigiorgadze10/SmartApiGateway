@using System.Text.Json
@model SmartApiGateway.Models.DashboardViewModel
@{
    ViewData["Title"] = "სტატისტიკა";
}

<div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-center bg-white p-4 rounded-2xl shadow-sm border border-slate-100 gap-4">
    <h2 class="text-xl font-bold text-slate-800">Overview</h2>
    
    <div class="flex flex-wrap gap-2">
        <a href="?filter=1h&limit=@Model.EndpointLimit" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 @(Model.ActiveFilter == "1h" ? "bg-indigo-600 text-white shadow-md shadow-indigo-500/30" : "bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200")">1 საათი</a>
        <a href="?filter=24h&limit=@Model.EndpointLimit" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 @(Model.ActiveFilter == "24h" ? "bg-indigo-600 text-white shadow-md shadow-indigo-500/30" : "bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200")">24 საათი</a>
        <a href="?filter=7d&limit=@Model.EndpointLimit" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 @(Model.ActiveFilter == "7d" ? "bg-indigo-600 text-white shadow-md shadow-indigo-500/30" : "bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200")">7 დღე</a>
        <a href="?filter=30d&limit=@Model.EndpointLimit" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 @(Model.ActiveFilter == "30d" ? "bg-indigo-600 text-white shadow-md shadow-indigo-500/30" : "bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200")">30 დღე</a>
        <a href="?filter=all&limit=@Model.EndpointLimit" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 @(Model.ActiveFilter == "all" ? "bg-indigo-600 text-white shadow-md shadow-indigo-500/30" : "bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200")">All Time</a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-3xl p-6 shadow-xl shadow-indigo-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10"><p class="text-indigo-100 text-sm font-semibold mb-1">სულ მოთხოვნები</p><h3 class="text-4xl font-black tracking-tight" id="statTotal">@Model.TotalRequests</h3></div>
        <i data-lucide="activity" class="absolute -bottom-4 -right-4 w-32 h-32 text-indigo-400 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>
    <div class="bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-3xl p-6 shadow-xl shadow-emerald-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10"><p class="text-emerald-100 text-sm font-semibold mb-1">წარმატებული (200 OK)</p><h3 class="text-4xl font-black tracking-tight" id="statSuccess">@Model.SuccessCount</h3></div>
        <i data-lucide="check-circle" class="absolute -bottom-4 -right-4 w-32 h-32 text-emerald-300 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>
    <div class="bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl p-6 shadow-xl shadow-orange-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10"><p class="text-orange-100 text-sm font-semibold mb-1">კლიენტის შეცდომა (4xx)</p><h3 class="text-4xl font-black tracking-tight" id="statClient">@Model.ClientErrorCount</h3></div>
        <i data-lucide="alert-triangle" class="absolute -bottom-4 -right-4 w-32 h-32 text-orange-300 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>
    <div class="bg-gradient-to-br from-rose-500 to-red-600 rounded-3xl p-6 shadow-xl shadow-red-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10"><p class="text-red-100 text-sm font-semibold mb-1">სერვერის შეცდომა (5xx)</p><h3 class="text-4xl font-black tracking-tight" id="statServer">@Model.ServerErrorCount</h3></div>
        <i data-lucide="server-crash" class="absolute -bottom-4 -right-4 w-32 h-32 text-red-400 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
    <div class="lg:col-span-2 bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
            <i data-lucide="trending-up" class="w-5 h-5 text-indigo-500 mr-2"></i> ტრაფიკის დინამიკა
        </h3>
        <div class="relative h-80"><canvas id="trafficChart"></canvas></div>
    </div>

    <div class="space-y-8">
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <i data-lucide="pie-chart" class="w-5 h-5 text-emerald-500 mr-2"></i> სტატუსები
            </h3>
            <div class="relative h-56 flex justify-center items-center"><canvas id="statusChart"></canvas></div>
        </div>

        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center">
                <i data-lucide="users" class="w-5 h-5 text-indigo-500 mr-2"></i> Top 5 IP
            </h3>
            <div class="space-y-3" id="topIpsContainer">
                @foreach (var ip in Model.TopIps)
                {
                    <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100">
                        <span class="font-mono text-sm text-slate-700 font-medium">@ip.Key</span>
                        <span class="bg-indigo-100 text-indigo-700 py-1 px-3 rounded-full text-xs font-bold">@ip.Value Req</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 mb-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center mb-6 gap-4">
        <h3 class="text-lg font-bold text-slate-800 flex items-center">
            <i data-lucide="route" class="w-5 h-5 text-blue-500 mr-2"></i> ენდპოინტების აქტივობა
        </h3>
        <div class="flex items-center space-x-1 bg-slate-50 p-1.5 rounded-xl border border-slate-200">
            <span class="text-xs font-bold text-slate-400 px-2 uppercase tracking-wider hidden sm:block">რაოდენობა:</span>
            <a href="?filter=@Model.ActiveFilter&limit=10" class="px-3 py-1.5 rounded-lg text-sm font-bold transition-all @(Model.EndpointLimit == 10 ? "bg-white text-blue-600 shadow-sm border border-slate-200/50" : "text-slate-500 hover:bg-slate-200/50 hover:text-slate-700")">10</a>
            <a href="?filter=@Model.ActiveFilter&limit=50" class="px-3 py-1.5 rounded-lg text-sm font-bold transition-all @(Model.EndpointLimit == 50 ? "bg-white text-blue-600 shadow-sm border border-slate-200/50" : "text-slate-500 hover:bg-slate-200/50 hover:text-slate-700")">50</a>
            <a href="?filter=@Model.ActiveFilter&limit=100" class="px-3 py-1.5 rounded-lg text-sm font-bold transition-all @(Model.EndpointLimit == 100 ? "bg-white text-blue-600 shadow-sm border border-slate-200/50" : "text-slate-500 hover:bg-slate-200/50 hover:text-slate-700")">100</a>
            <a href="?filter=@Model.ActiveFilter&limit=0" class="px-3 py-1.5 rounded-lg text-sm font-bold transition-all @(Model.EndpointLimit == 0 ? "bg-white text-blue-600 shadow-sm border border-slate-200/50" : "text-slate-500 hover:bg-slate-200/50 hover:text-slate-700")">ყველა</a>
        </div>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-sm border-b border-slate-100">
                    <th class="p-4 font-semibold rounded-tl-xl">მარშრუტი (Path)</th>
                    <th class="p-4 font-semibold text-center">სულ</th>
                    <th class="p-4 font-semibold text-center">2xx (OK)</th>
                    <th class="p-4 font-semibold text-center">4xx (კლიენტი)</th>
                    <th class="p-4 font-semibold text-center rounded-tr-xl">5xx (სერვერი)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var stat in Model.EndpointStats)
                {
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-4 text-sm font-medium text-slate-700 flex items-center">
                            <span class="w-2 h-2 rounded-full mr-3 @(stat.ServerErrorCount > 0 ? "bg-red-500" : stat.ClientErrorCount > 0 ? "bg-amber-500" : "bg-emerald-500")"></span>
                            @stat.Path
                        </td>
                        <td class="p-4 text-sm text-center font-bold text-slate-700">@stat.TotalCount</td>
                        <td class="p-4 text-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold @(stat.SuccessCount > 0 ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-400")">
                                @stat.SuccessCount
                            </span>
                        </td>
                        <td class="p-4 text-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold @(stat.ClientErrorCount > 0 ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-400")">
                                @stat.ClientErrorCount
                            </span>
                        </td>
                        <td class="p-4 text-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold @(stat.ServerErrorCount > 0 ? "bg-red-100 text-red-700" : "bg-slate-100 text-slate-400")">
                                @stat.ServerErrorCount
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 mb-8">
    <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
        <i data-lucide="list" class="w-5 h-5 text-indigo-500 mr-2"></i> ბოლო მოთხოვნები (Live)
    </h3>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-sm border-b border-slate-100">
                    <th class="p-4 font-semibold rounded-tl-xl w-24">დრო</th>
                    <th class="p-4 font-semibold">მარშრუტი & მეთოდი</th>
                    <th class="p-4 font-semibold text-center w-32">სტატუს კოდი</th>
                    <th class="p-4 font-semibold text-center w-32">ხანგრძლივობა</th>
                    <th class="p-4 font-semibold rounded-tr-xl w-40">IP მისამართი</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var log in Model.RecentLogs)
                {
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-4 text-sm text-slate-500">@log.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td class="p-4 text-sm font-medium text-slate-700 flex items-center mt-1">
                            @{
                                string methodColor = log.HttpMethod == "GET" ? "bg-blue-100 text-blue-700" :
                                                     log.HttpMethod == "POST" ? "bg-emerald-100 text-emerald-700" :
                                                     log.HttpMethod == "PUT" ? "bg-amber-100 text-amber-700" :
                                                     log.HttpMethod == "DELETE" ? "bg-red-100 text-red-700" : "bg-slate-100 text-slate-600";
                            }
                            <span class="text-[10px] uppercase font-black px-2 py-1 rounded mr-3 @methodColor tracking-wider">
                                @log.HttpMethod
                            </span>
                            @log.RequestedUrl
                        </td>
                        <td class="p-4 text-center">
                            @{
                                string statusClass = log.StatusCode >= 500 ? "bg-red-100 text-red-700 border border-red-200" :
                                                     log.StatusCode >= 400 ? "bg-amber-100 text-amber-700 border border-amber-200" :
                                                     log.StatusCode >= 200 && log.StatusCode < 300 ? "bg-emerald-100 text-emerald-700 border border-emerald-200" :
                                                     "bg-slate-100 text-slate-600";
                            }
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold shadow-sm @statusClass">
                                <span class="w-1.5 h-1.5 rounded-full mr-2 @(log.StatusCode >= 500 ? "bg-red-500" : log.StatusCode >= 400 ? "bg-amber-500" : "bg-emerald-500")"></span>
                                @log.StatusCode
                            </span>
                        </td>
                        <td class="p-4 text-center text-sm font-medium text-slate-600">
                            @log.ResponseTimeMs <span class="text-xs text-slate-400">ms</span>
                        </td>
                        <td class="p-4 text-sm text-slate-500 font-mono">@log.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script>
        const trafficLabels = JSON.parse('@Html.Raw(JsonSerializer.Serialize(Model.ChartLabels))');
        const trafficData = JSON.parse('@Html.Raw(JsonSerializer.Serialize(Model.ChartData))');

        const ctxTraffic = document.getElementById('trafficChart').getContext('2d');
        let gradient = ctxTraffic.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(99, 102, 241, 0.5)');
        gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

        let trafficChart = new Chart(ctxTraffic, {
        type: 'line',
        data: { labels: trafficLabels, datasets: [{ label: 'მოთხოვნები', data: trafficData, borderColor: '#4f46e5', backgroundColor: gradient, borderWidth: 3, fill: true, tension: 0.4 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true } } }
        });

        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        let statusChart = new Chart(ctxStatus, {
        type: 'doughnut',
        data: { labels: ['200 OK', '4xx Error', '5xx Error'], datasets: [{ data: [Number('@Model.SuccessCount'), Number('@Model.ClientErrorCount'), Number('@Model.ServerErrorCount')], backgroundColor: ['#10b981', '#f59e0b', '#ef4444'], borderWidth: 0 }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '75%', plugins: { legend: { position: 'bottom' } } }
        });

        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/trafficHub")
        .withAutomaticReconnect()
        .build();

        connection.on("ReceiveLog", function (log) {
            
        let totalEl = document.getElementById('statTotal');
        totalEl.innerText = parseInt(totalEl.innerText) + 1;

        if (log.status >= 200 && log.status < 300) {
        let el = document.getElementById('statSuccess');
        el.innerText = parseInt(el.innerText) + 1;
        statusChart.data.datasets[0].data[0]++;
        } else if (log.status >= 400 && log.status < 500) {
        let el = document.getElementById('statClient');
        el.innerText = parseInt(el.innerText) + 1;
        statusChart.data.datasets[0].data[1]++;
        } else if (log.status >= 500) {
        let el = document.getElementById('statServer');
        el.innerText = parseInt(el.innerText) + 1;
        statusChart.data.datasets[0].data[2]++;
        }
        statusChart.update();

        const tables = document.querySelectorAll('table');
        const logsTbody = tables[tables.length - 1].querySelector('tbody');

        if(logsTbody) {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('ka-GE', { hour12: false });
                
        let methodColor = log.method === "GET" ? "bg-blue-100 text-blue-700" :
        log.method === "POST" ? "bg-emerald-100 text-emerald-700" :
        log.method === "PUT" ? "bg-amber-100 text-amber-700" :
        log.method === "DELETE" ? "bg-red-100 text-red-700" : "bg-slate-100 text-slate-600";
                                  
        let statusClass = log.status >= 500 ? "bg-red-100 text-red-700 border-red-200" :
        log.status >= 400 ? "bg-amber-100 text-amber-700 border-amber-200" :
        log.status >= 200 && log.status < 300 ? "bg-emerald-100 text-emerald-700 border-emerald-200" : "bg-slate-100 text-slate-600";
                                  
        let dotClass = log.status >= 500 ? "bg-red-500" : log.status >= 400 ? "bg-amber-500" : "bg-emerald-500";

        const newRowHTML = `
        <tr class="transition-colors bg-blue-50/70 hover:bg-slate-50">
        <td class="p-4 text-sm text-slate-500">${timeStr}</td>
        <td class="p-4 text-sm font-medium text-slate-700 flex items-center mt-1">
        <span class="text-[10px] uppercase font-black px-2 py-1 rounded mr-3 ${methodColor} tracking-wider">${log.method}</span>
        ${log.url}
        </td>
        <td class="p-4 text-center">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold shadow-sm border ${statusClass}">
        <span class="w-1.5 h-1.5 rounded-full mr-2 ${dotClass}"></span>${log.status}
        </span>
        </td>
        <td class="p-4 text-center text-sm font-medium text-slate-600">${log.time} <span class="text-xs text-slate-400">ms</span></td>
        <td class="p-4 text-sm text-slate-500 font-mono">${log.ipAddress}</td>
        </tr>
        `;
                
        logsTbody.insertAdjacentHTML('afterbegin', newRowHTML);
                
        if(logsTbody.children.length > 100) {
        logsTbody.removeChild(logsTbody.lastChild);
        }
        }

        if(trafficChart) {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('ka-GE', { hour: '2-digit', minute:'2-digit' });
        trafficChart.data.labels.push(timeStr);
        trafficChart.data.datasets[0].data.push(log.time);
                
        if(trafficChart.data.labels.length > 50) {
        trafficChart.data.labels.shift();
        trafficChart.data.datasets[0].data.shift();
        }
        trafficChart.update();
        }
        });

        connection.start().then(() => console.log("SignalR LIVE Connected!")).catch(err => console.error(err));
    </script>
}