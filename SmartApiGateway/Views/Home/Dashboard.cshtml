@model SmartApiGateway.Models.DashboardViewModel
@{
    ViewData["Title"] = "სტატისტიკა";
}

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-3xl p-6 shadow-xl shadow-indigo-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-indigo-100 text-sm font-semibold mb-1">სულ მოთხოვნები</p>
            <h3 class="text-4xl font-black tracking-tight">@Model.TotalRequests</h3>
        </div>
        <i data-lucide="activity" class="absolute -bottom-4 -right-4 w-32 h-32 text-indigo-400 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>

    <div class="bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-3xl p-6 shadow-xl shadow-emerald-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-emerald-100 text-sm font-semibold mb-1">წარმატებული (200 OK)</p>
            <h3 class="text-4xl font-black tracking-tight">@Model.SuccessCount</h3>
        </div>
        <i data-lucide="check-circle" class="absolute -bottom-4 -right-4 w-32 h-32 text-emerald-300 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>

    <div class="bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl p-6 shadow-xl shadow-orange-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-orange-100 text-sm font-semibold mb-1">კლიენტის შეცდომა (4xx)</p>
            <h3 class="text-4xl font-black tracking-tight">@Model.ClientErrorCount</h3>
        </div>
        <i data-lucide="alert-triangle" class="absolute -bottom-4 -right-4 w-32 h-32 text-orange-300 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>

    <div class="bg-gradient-to-br from-rose-500 to-red-600 rounded-3xl p-6 shadow-xl shadow-red-500/30 text-white relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-red-100 text-sm font-semibold mb-1">სერვერის შეცდომა (5xx)</p>
            <h3 class="text-4xl font-black tracking-tight">@Model.ServerErrorCount</h3>
        </div>
        <i data-lucide="server-crash" class="absolute -bottom-4 -right-4 w-32 h-32 text-red-400 opacity-20 group-hover:scale-110 transition duration-500"></i>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2 bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
            <i data-lucide="trending-up" class="w-5 h-5 text-indigo-500 mr-2"></i> ტრაფიკის დინამიკა
        </h3>
        <div class="relative h-80">
            <canvas id="trafficChart"></canvas>
        </div>
    </div>

    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
            <i data-lucide="pie-chart" class="w-5 h-5 text-emerald-500 mr-2"></i> სტატუსების გადანაწილება
        </h3>
        <div class="relative h-72 flex justify-center items-center">
            <canvas id="statusChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // მთავარი გრაფიკი ლამაზი გრადიენტით
        const ctxTraffic = document.getElementById('trafficChart').getContext('2d');
        let gradient = ctxTraffic.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(99, 102, 241, 0.5)'); // Indigo
        gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

        const trafficLabels = JSON.parse('@Html.Raw(JsonSerializer.Serialize(Model.ChartLabels))');
        const trafficData = JSON.parse('@Html.Raw(JsonSerializer.Serialize(Model.ChartData))');

        new Chart(ctxTraffic, {
        type: 'line',
        data: {
        labels: trafficLabels,
        datasets: [{
        label: 'მოთხოვნები',
        data: trafficData,
        borderColor: '#4f46e5',
        backgroundColor: gradient,
        borderWidth: 3,
        pointBackgroundColor: '#ffffff',
        pointBorderColor: '#4f46e5',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6,
        fill: true,
        tension: 0.4 // ხაზის დამრგვალება
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        x: { grid: { display: false }, ticks: { color: '#64748b', font: { family: 'sans-serif' } } },
        y: { grid: { color: '#f1f5f9', borderDash: [5, 5] }, ticks: { color: '#64748b', font: { family: 'sans-serif' } }, beginAtZero: true }
        }
        }
        });

        // სტატუსების წრიული გრაფიკი
        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
        type: 'doughnut',
        data: {
        labels: ['წარმატებული', 'კლიენტის ერორი', 'სერვერის ერორი'],
        datasets: [{
        data: [Number('@Model.SuccessCount'), Number('@Model.ClientErrorCount'), Number('@Model.ServerErrorCount')],
        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'], // Emerald, Amber, Red
        borderWidth: 0,
        hoverOffset: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '75%', // შიგნით სიცარიელის ზომა
        plugins: {
        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20, font: { family: 'sans-serif', weight: 'bold' } } }
        }
        }
        });
    </script>
}